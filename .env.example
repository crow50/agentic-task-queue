# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# Read by dispatcher.py and coordinator_bot.py at startup. .env is gitignored;
# never commit real values. An empty value means "use the built-in default".
# tests/test_env_example.py fails if the code reads a setting not listed here.

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather, and the chat id to notify. Get the chat id by
# messaging your bot once, then visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The one Telegram user id allowed to command the coordinator bot (a message must
# come from this chat AND this user). Leave empty in a private chat, where it
# defaults to TELEGRAM_CHAT_ID. Required if TELEGRAM_CHAT_ID is a group chat
# (a negative id): without it the bot refuses to start. Find yours with @userinfobot.
TELEGRAM_USER_ID=
# Bot API base URL. Leave unset; only tests (or a local Bot API server) change it.
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Claude CLI ---------------------------------------------------------------
# Absolute path to the claude binary. Cron runs with a minimal PATH, so an
# absolute path is strongly recommended (find it with: which claude).
CLAUDE_BIN=
# Long-lived login for the queue: `claude setup-token` prints one (valid a year,
# model requests only). scripts/install.py stores it here and records the date
# below; `install.py --check` warns when it is older than 11 months. Unlike an
# interactive login it does not expire after a few hours or days.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_CREATED=
# Optional fine-grained GitHub token (only the repos the queue needs), handed to
# claude as GH_TOKEN so tasks can use `gh`. Leave empty for none.
# Also used by the dispatcher itself, to push task branches and open draft pull
# requests for `repo:` tasks (needs Contents and Pull requests read/write on that
# repo, and an https `origin`). Leave empty for none.
GH_TOKEN=

# --- Task defaults (used when a task's frontmatter omits the matching key) ----
DEFAULT_TIMEOUT_MINUTES=30
DEFAULT_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write
# Working directory for tasks that don't set cwd. Empty = <queue dir>/workspace
DEFAULT_CWD=
# Optional MCP servers JSON applied to every task that doesn't set its own
# mcp_config frontmatter key. Relative to this directory unless absolute.
# Leave empty for no MCP by default.
DEFAULT_MCP_CONFIG=

# --- Rate limits, pauses and review -------------------------------------------
# Transient 429/overloaded errors: retries per claude call, and the base delay in
# seconds (delay = base * 2^retry + jitter, capped at 10 minutes). When the retries
# run out, or the CLI names a reset time, the queue pauses (state/paused_until).
MAX_RATE_LIMIT_RETRIES=2
RATE_LIMIT_BASE_DELAY=30
# How long to pause for a usage limit whose message has no reset time.
USAGE_LIMIT_COOLDOWN_MINUTES=60
# Attempts (worker calls that used up an attempt) per local day, counted from
# logs/usage.jsonl. At the cap the queue pauses until midnight. 0 turns the cap off.
MAX_ATTEMPTS_PER_DAY=12
# Model for retries when a task has no escalation_model. A task that names Opus
# (model or escalation_model) still gets it; Opus is never the default.
DEFAULT_ESCALATION_MODEL=claude-sonnet-5
# Model for the one cheap call made each run while the login is expired.
PROBE_MODEL=claude-haiku-4-5-20251001
# Timeout for the review call (the per-task timeout only covers the worker).
REVIEW_TIMEOUT_MINUTES=10

# Tools a task's allowed_tools line may grant: comma-separated fnmatch patterns,
# commas inside parentheses don't split. Empty = the built-in list, which allows
# `Bash(gh issue *)` and `Bash(gh pr create*)` but not `Bash(gh *)` or `gh api`.
TASK_ALLOWED_TOOLS=

# --- Housekeeping -------------------------------------------------------------
# Per-attempt transcripts (logs/*.attempt-*) older than this many days are deleted
# each run, to spare an SD card. 0 keeps everything.
LOG_RETENTION_DAYS=30
# Dead-man's-switch URL (e.g. healthchecks.io), pinged once after each successful
# cycle; it alerts you when the pings stop (power cut, dead card, dead cron).
# Not pinged while the claude login is expired. Empty = off.
HEALTHCHECK_URL=

# --- Task verification (a task's `verify:` line) ------------------------------
# Commands the dispatcher itself runs after the worker, in the task's cwd, with no
# shell and a scrubbed environment. A task's `verify:` command must start with one
# of these comma-separated prefixes, compared word by word; a last word ending in
# "-" or "/" is the start of a word (scripts/verify- allows scripts/verify-x.sh).
# Anything else sends the task straight to failed/. These run with this process's
# privileges, so list only commands you would run yourself.
VERIFY_ALLOWED_PREFIXES=python3 -m unittest,pytest,bash scripts/verify-
# Minutes a verify command may run before it is stopped and the attempt fails.
VERIFY_TIMEOUT_MINUTES=10

# --- Visibility: warnings, budgets, session rotation ---------------------------
# Each is off at 0 or empty. An alert says what crossed which line and what to do, and
# is sent once a day per condition. `python3 dispatcher.py usage --by day` shows the
# numbers to set budgets from; the queue cannot see your plan's real limit.
# A call that fills this percent of the model's context window raises an alert. For a
# worker it means the task is too big for one run; for the coordinator it is the
# warning before the rotation below. The installer sets 70 on an existing install.
CONTEXT_WARN_PCT=70
# At this percent the coordinator's next message first saves the key facts of the
# session to coordinator/memory/session.md, then starts a fresh session and tells you
# so in one line. The installer sets 85 on an existing install.
CONTEXT_ROTATE_PCT=85
# Kilobytes the coordinator's memory folder may hold. The oldest lines of the
# rolling notes (session.md) are dropped first; MEMORY.md and preferences.md never are.
COORDINATOR_MEMORY_MAX_KB=64
# Your own spend limits for one local day. DAILY_COST_BUDGET_USD counts the dollars the
# CLI reports; DAILY_TOKEN_BUDGET counts billed tokens (input, cache writes and output,
# not cache reads). Crossing one sends an alert; it does not stop the queue.
DAILY_COST_BUDGET_USD=0
DAILY_TOKEN_BUDGET=0

# What the assistant is called in Telegram messages and in the morning brief. The menu
# button "Name your assistant" proposes names and records the pick (here, in
# coordinator/identity.md and as this default, through a pull request).
ASSISTANT_NAME=taskq

# --- Coordinator chat bridge (coordinator_bot.py) -----------------------------
# Empty COORDINATOR_ALLOWED_TOOLS means Read,Glob,Grep plus Write/Edit scoped
# to the tasks/ and coordinator/memory/ directories.
COORDINATOR_MODEL=claude-sonnet-5
COORDINATOR_TIMEOUT_MINUTES=10
COORDINATOR_ALLOWED_TOOLS=

# --- Autonomy (tiers, approval, pull requests, live status) -------------------
# A task's tier is computed from its allowed_tools: 0 reads only, 1 writes inside
# its own workspace, 2 leaves the box (git push, gh, ssh, deploys). A task that
# sets `repo:` is always tier 2: the dispatcher pushes its branch and opens a
# DRAFT pull request. Nothing here ever merges.
# Extra commands to count as tier 2, comma separated, matched at the start of a
# Bash(...) pattern (for example "make deploy,./release.sh").
TIER2_BASH=
# Tasks at or above this tier wait in tasks/proposed/ until you approve them with
# a 👍 on the announcement (or /approve <id>). 0 turns the gate off. 1 means
# anything that writes needs your 👍; reading tasks (tier 0) just run.
APPROVAL_MIN_TIER=1
# Where `repo: name` is looked up. Empty = workspace/ next to dispatcher.py.
# An absolute `repo:` path is used as is.
REPOS_DIR=
# Open draft pull requests (branches task/*) allowed at once. At the cap a
# finished task is held, with one notice, until you merge or close one.
MAX_OPEN_PRS=3
# The gh command used to count and open draft pull requests. Empty = `gh`; the
# GH_TOKEN above is given to it.
GH_BIN=
# After a held or failed pull request publish, wait this many minutes before trying
# again (0 = at once), so an event-driven run does not loop on it.
PUBLISH_RETRY_MINUTES=10
# Before a `repo:` task is committed, the dispatcher scans the change. It refuses
# (and fails the attempt, with feedback that names the path, never a value) a path
# matching DIFF_GUARD_DENY, an added file over DIFF_GUARD_MAX_KB, and an added line
# that looks like a key or token. DIFF_GUARD_DENY is comma separated: `name/` is a
# folder anywhere in the path, anything else a file glob. Setting it replaces the
# list below, so repeat the entries you want to keep. Only you can loosen this.
DIFF_GUARD_DENY=.venv/,venv/,node_modules/,__pycache__/,*.pyc,.env,*.pem,id_rsa*,*.sqlite
DIFF_GUARD_MAX_KB=1024
# The live status message is edited at most this often (seconds).
STATUS_EDIT_INTERVAL_SECONDS=10
# Follow-up tasks a worker proposes (tasks/proposed/): how deep the chain may go,
# and how many one task may propose. You approve each by 👍.
MAX_PROPOSAL_DEPTH=2
MAX_PROPOSALS_PER_TASK=5
# Event-driven runs: the systemd unit taskq-dispatch.service sets both of these for
# itself, so leave them empty here. DISPATCH_DRAIN=1 keeps one run going until the
# queue is empty; the lock wait (seconds) makes a run started by a new file wait for
# the one that is working instead of exiting. Cron leaves both off.
DISPATCH_DRAIN=
DISPATCH_LOCK_WAIT_SECONDS=
