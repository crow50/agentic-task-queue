# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# Read by dispatcher.py and coordinator_bot.py at startup. .env is gitignored;
# never commit real values. An empty value means "use the built-in default".
# tests/test_env_example.py fails if the code reads a setting not listed here.

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather, and the chat id to notify. Get the chat id by
# messaging your bot once, then visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The one Telegram user id allowed to command the coordinator bot (a message must
# come from this chat AND this user). Leave empty in a private chat, where it
# defaults to TELEGRAM_CHAT_ID. Required if TELEGRAM_CHAT_ID is a group chat
# (a negative id): without it the bot refuses to start. Find yours with @userinfobot.
TELEGRAM_USER_ID=
# Bot API base URL. Leave unset; only tests (or a local Bot API server) change it.
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Claude CLI ---------------------------------------------------------------
# Absolute path to the claude binary. Cron runs with a minimal PATH, so an
# absolute path is strongly recommended (find it with: which claude).
CLAUDE_BIN=
# Long-lived login for the queue: `claude setup-token` prints one (valid a year,
# model requests only). scripts/install.py stores it here and records the date
# below; `install.py --check` warns when it is older than 11 months. Unlike an
# interactive login it does not expire after a few hours or days.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN_CREATED=
# Optional fine-grained GitHub token (only the repos the queue needs), handed to
# claude as GH_TOKEN so tasks can use `gh`. Leave empty for none.
GH_TOKEN=

# --- Task defaults (used when a task's frontmatter omits the matching key) ----
DEFAULT_TIMEOUT_MINUTES=30
DEFAULT_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write
# Working directory for tasks that don't set cwd. Empty = <queue dir>/workspace
DEFAULT_CWD=
# Optional MCP servers JSON applied to every task that doesn't set its own
# mcp_config frontmatter key. Relative to this directory unless absolute.
# Leave empty for no MCP by default.
DEFAULT_MCP_CONFIG=

# --- Rate limits, pauses and review -------------------------------------------
# Transient 429/overloaded errors: retries per claude call, and the base delay in
# seconds (delay = base * 2^retry + jitter, capped at 10 minutes). When the retries
# run out, or the CLI names a reset time, the queue pauses (state/paused_until).
MAX_RATE_LIMIT_RETRIES=2
RATE_LIMIT_BASE_DELAY=30
# How long to pause for a usage limit whose message has no reset time.
USAGE_LIMIT_COOLDOWN_MINUTES=60
# Attempts (worker calls that used up an attempt) per local day, counted from
# logs/usage.jsonl. At the cap the queue pauses until midnight. 0 turns the cap off.
MAX_ATTEMPTS_PER_DAY=12
# Model for retries when a task has no escalation_model. A task that names Opus
# (model or escalation_model) still gets it; Opus is never the default.
DEFAULT_ESCALATION_MODEL=claude-sonnet-5
# Model for the one cheap call made each run while the login is expired.
PROBE_MODEL=claude-haiku-4-5-20251001
# Timeout for the review call (the per-task timeout only covers the worker).
REVIEW_TIMEOUT_MINUTES=10

# Tools a task's allowed_tools line may grant: comma-separated fnmatch patterns,
# commas inside parentheses don't split. Empty = the built-in list, which allows
# `Bash(gh issue *)` and `Bash(gh pr create*)` but not `Bash(gh *)` or `gh api`.
TASK_ALLOWED_TOOLS=

# --- Housekeeping -------------------------------------------------------------
# Per-attempt transcripts (logs/*.attempt-*) older than this many days are deleted
# each run, to spare an SD card. 0 keeps everything.
LOG_RETENTION_DAYS=30
# Dead-man's-switch URL (e.g. healthchecks.io), pinged once after each successful
# cycle; it alerts you when the pings stop (power cut, dead card, dead cron).
# Not pinged while the claude login is expired. Empty = off.
HEALTHCHECK_URL=

# --- Task verification (a task's `verify:` line) ------------------------------
# Commands the dispatcher itself runs after the worker, in the task's cwd, with no
# shell and a scrubbed environment. A task's `verify:` command must start with one
# of these comma-separated prefixes, compared word by word; a last word ending in
# "-" or "/" is the start of a word (scripts/verify- allows scripts/verify-x.sh).
# Anything else sends the task straight to failed/. These run with this process's
# privileges, so list only commands you would run yourself.
VERIFY_ALLOWED_PREFIXES=python3 -m unittest,pytest,bash scripts/verify-
# Minutes a verify command may run before it is stopped and the attempt fails.
VERIFY_TIMEOUT_MINUTES=10

# --- Coordinator chat bridge (coordinator_bot.py) -----------------------------
# Empty COORDINATOR_ALLOWED_TOOLS means Read,Glob,Grep plus Write/Edit scoped
# to the tasks/ and coordinator/memory/ directories.
COORDINATOR_MODEL=claude-sonnet-5
COORDINATOR_TIMEOUT_MINUTES=10
COORDINATOR_ALLOWED_TOOLS=
